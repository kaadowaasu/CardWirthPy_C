#!/usr/bin/env bash
set -euo pipefail

app_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
install_root="$(CDPATH= cd -- "${app_dir}/.." && pwd)"
user_data="${CARDWIRTH_USER_DATA:-${install_root}/UserData}"

# 読み取り専用の可能性があるインストール先に触れる前に、コマンドラインの上書き設定を解決する。
expect_user_data=0
for argument in "$@"; do
    if (( expect_user_data )); then
        user_data="$argument"
        expect_user_data=0
    elif [[ "$argument" == "--user-data" ]]; then
        expect_user_data=1
    elif [[ "$argument" == --user-data=* ]]; then
        user_data="${argument#--user-data=}"
    fi
done
if (( expect_user_data )) || [[ -z "$user_data" ]]; then
    printf '%s\n' '--user-data requires a nonempty folder path.' >&2
    exit 1
fi
mkdir -p -- "${user_data}"
user_data="$(CDPATH= cd -- "${user_data}" && pwd)"
if [[ -n "${WSL_DISTRO_NAME:-}" && -n "${PULSE_SERVER:-}" &&
      -z "${SDL_AUDIODRIVER:-}" ]]; then
    export SDL_AUDIODRIVER=pulseaudio
fi
exec "${app_dir}/@CARDWIRTH_OUTPUT_NAME@" \
    --user-data "${user_data}" "$@"
