+        // Publish the same SDL key events used by the physical keyboard.
+        event.type = SDL_EVENT_KEY_DOWN;
+        event.key.windowID = window_id;
+        event.key.which = SDL_GLOBAL_KEYBOARD_ID;
+        event.key.scancode = composing == 2 ? SDL_SCANCODE_BACKSPACE :
+                             composing == 3 ? SDL_SCANCODE_DELETE : SDL_SCANCODE_RETURN;
+        event.key.key = composing == 2 ? SDLK_BACKSPACE :
+                        composing == 3 ? SDLK_DELETE : SDLK_RETURN;
+        event.key.down = true;
+        SDL_PushEvent(&event);
+        event.type = SDL_EVENT_KEY_UP;
+        event.key.down = false;
+        SDL_PushEvent(&event);
+        return;
+    }
+    // Cancelling conversion still has to clear the visible preedit.
+    if (!composing && text && !*text) composing = 1;
+    event.type = composing ? SDL_EVENT_TEXT_EDITING : SDL_EVENT_TEXT_INPUT;
+    if (!text || !SDL_EventEnabled(event.type)) return;
+    if (!composing && (!*text || SDL_iscntrl((unsigned char)*text))) return;
+    const char *owned = SDL_CreateTemporaryString(text);
+    if (!owned) return;
+    if (composing) {
+        event.edit.windowID = window_id;
+        event.edit.text = owned;
+        event.edit.start = SDL_utf8strlen(text);
+    } else {
+        event.text.windowID = window_id;
+        event.text.text = owned;
+    }
+    SDL_PushEvent(&event);
+}
+
+static bool Emscripten_StartTextInput(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID props)
+{
+    Emscripten_PublishTextInput(true, true, window);
+    return true;
+}
+
+static bool Emscripten_StopTextInput(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    Emscripten_PublishTextInput(false, true, window);
+    return true;
+}
+
+static bool Emscripten_UpdateTextInputArea(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (SDL_TextInputActive(window)) Emscripten_PublishTextInput(true, false, window);
+    return true;
+}
+
+static bool Emscripten_ClearComposition(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (SDL_TextInputActive(window)) Emscripten_PublishTextInput(true, true, window);
+    return true;
+}
 
