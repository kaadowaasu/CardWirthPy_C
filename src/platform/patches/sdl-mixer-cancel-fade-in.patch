+bool MIX_CardWirthCancelTrackFadeIn(MIX_Track *track)
+{
+    if (!CheckTrackParam(track)) {
+        return false;
+    }
+
+    LockTrack(track);
+    if (track->fade_direction > 0) {
+        track->fade_frames = 0;
+        track->total_fade_frames = 0;
+        track->fade_direction = 0;
+        track->fade_start_gain = 1.0f;
+    }
+    UnlockTrack(track);
+    return true;
+}
