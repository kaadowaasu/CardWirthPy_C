# 全アプリホストで、診断実装と ABI の接続を一つにする。
function(cardwirth_enable_exception_origin target)
    get_filename_component(origin_source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cw/lib/exception_origin.cpp" ABSOLUTE)
    get_filename_component(origin_include "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_target_property(existing_sources ${target} SOURCES)
    get_target_property(source_directory ${target} SOURCE_DIR)
    set(has_origin FALSE)
    foreach(source IN LISTS existing_sources)
        get_filename_component(absolute_source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
        if(absolute_source STREQUAL origin_source)
            set(has_origin TRUE)
        endif()
    endforeach()
    if(NOT has_origin)
        target_sources(${target} PRIVATE "${origin_source}")
    endif()
    target_include_directories(${target} PRIVATE "${origin_include}")
    target_compile_features(${target} PRIVATE cxx_std_20)
    if(WIN32)
        target_link_libraries(${target} PRIVATE dbghelp)
    elseif(UNIX AND NOT EMSCRIPTEN)
        target_link_libraries(${target} PRIVATE ${CMAKE_DL_LIBS})
        if(NOT APPLE AND NOT ANDROID)
            target_link_options(${target} PRIVATE -rdynamic)
        endif()
    endif()
    # Web と Android は例外ランタイムを静的リンクする。第二のラン
    # タイムシンボルを定義せず、リンカーの境界でそのメモリー確保を観測する。
    if(EMSCRIPTEN OR ANDROID)
        target_link_options(${target} PRIVATE "-Wl,--wrap=__cxa_allocate_exception")
    endif()
endfunction()
