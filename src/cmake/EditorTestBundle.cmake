# 独立したテスト翻訳単位で、一つのリンク済み GUI 実行ファイルを共有する。各
# CTest は新しいプロセスで、元の main() の入口を一つだけ選ぶ。
option(CARDWIRTH_BUNDLE_EDITOR_TESTS "Link compatible editor tests into one executable" ON)

function(cardwirth_add_bundled_editor_test target)
    cmake_parse_arguments(CASE "WITH_ARGS" "" "" ${ARGN})
    if(CARDWIRTH_BUNDLE_EDITOR_TESTS)
        add_library(${target} OBJECT ${CASE_UNPARSED_ARGUMENTS})
        target_compile_definitions(${target} PRIVATE "main=cardwirth_case_${target}")
        if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            target_compile_options(${target} PRIVATE -Werror=return-type)
        endif()
        set_property(TARGET ${target} PROPERTY CARDWIRTH_EDITOR_CASE_WITH_ARGS ${CASE_WITH_ARGS})
        set_property(GLOBAL APPEND PROPERTY CARDWIRTH_EDITOR_BUNDLE_CASES ${target})
        set(${target}_TEST_COMMAND "$<TARGET_FILE:editor_gui_test_bundle>;--case;${target}" PARENT_SCOPE)
    else()
        add_executable(${target} ${CASE_UNPARSED_ARGUMENTS})
        set(${target}_TEST_COMMAND "${target}" PARENT_SCOPE)
    endif()
endfunction()

# リソースはテストが読み戻す実行可能イメージに含める。まとめた
# 構成では各ケースはオブジェクトライブラリーなので、リソースを
# 実行不能なターゲットに残さず共通実行ファイルへリンクする。
function(cardwirth_attach_editor_test_resource target)
    if(CARDWIRTH_BUNDLE_EDITOR_TESTS)
        set_property(TARGET ${target} APPEND PROPERTY
            CARDWIRTH_EDITOR_TEST_RESOURCE_SOURCES ${ARGN})
    else()
        target_sources(${target} PRIVATE ${ARGN})
    endif()
endfunction()

function(cardwirth_finalize_editor_test_bundle)
    get_property(cases GLOBAL PROPERTY CARDWIRTH_EDITOR_BUNDLE_CASES)
    if(NOT CARDWIRTH_BUNDLE_EDITOR_TESTS OR NOT cases)
        return()
    endif()
    set(dispatcher "#include <cstdio>\n#include <cstring>\n")
    foreach(case IN LISTS cases)
        get_target_property(with_args ${case} CARDWIRTH_EDITOR_CASE_WITH_ARGS)
        if(with_args)
            string(APPEND dispatcher "int cardwirth_case_${case}(int, char**);\n")
        else()
            string(APPEND dispatcher "int cardwirth_case_${case}();\n")
        endif()
    endforeach()
    string(APPEND dispatcher "int main(int argc, char** argv) {\n")
    string(APPEND dispatcher "  if (argc == 2 && std::strcmp(argv[1], \"--list\") == 0) {\n")
    foreach(case IN LISTS cases)
        string(APPEND dispatcher "    std::puts(\"${case}\");\n")
    endforeach()
    string(APPEND dispatcher "    return 0;\n  }\n")
    string(APPEND dispatcher "  if (argc >= 3 && std::strcmp(argv[1], \"--case\") == 0) {\n")
    foreach(case IN LISTS cases)
        get_target_property(with_args ${case} CARDWIRTH_EDITOR_CASE_WITH_ARGS)
        if(with_args)
        string(APPEND dispatcher "    if (std::strcmp(argv[2], \"${case}\") == 0) return cardwirth_case_${case}(argc - 2, argv + 2);\n")
        else()
        string(APPEND dispatcher "    if (argc == 3 && std::strcmp(argv[2], \"${case}\") == 0) return cardwirth_case_${case}();\n")
        endif()
    endforeach()
    string(APPEND dispatcher "  }\n  std::fputs(\"Usage: editor_gui_test_bundle --list | --case NAME\\n\", stderr);\n  return 2;\n}\n")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/editor_gui_test_bundle_main.cpp")
    file(GENERATE OUTPUT "${generated}" CONTENT "${dispatcher}")
    add_executable(editor_gui_test_bundle "${generated}")
    target_compile_features(editor_gui_test_bundle PRIVATE cxx_std_20)
    target_link_libraries(editor_gui_test_bundle PRIVATE cwxeditor_test_support)
    foreach(case IN LISTS cases)
        get_target_property(resources ${case} CARDWIRTH_EDITOR_TEST_RESOURCE_SOURCES)
        if(resources)
            target_sources(editor_gui_test_bundle PRIVATE ${resources})
        endif()
        target_sources(editor_gui_test_bundle PRIVATE $<TARGET_OBJECTS:${case}>)
    endforeach()
    # 既存の一括ターゲットも、オブジェクトだけでなく実行可能ファイルを作る。
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind ${target} TYPE)
        if(kind STREQUAL "UTILITY" AND target MATCHES "^editor_gui_")
            add_dependencies(${target} editor_gui_test_bundle)
        endif()
    endforeach()
endfunction()
